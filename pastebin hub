--[[
	PasteBin Hub  v1.0
	==================
	Librería de UI para Roblox: UN SOLO RECTÁNGULO, negro con verde
	estilo terminal / código. Arriba las pestañas (tabs) en una fila,
	abajo los controles de la pestaña activa (botones, toggles,
	sliders, dropdowns, inputs, teclas...). Pensada para meterle tus
	códigos como si fuera tu hub.

	Misma estructura que AzucarDulce (CreateWindow / CreateTab /
	CreateToggle...), así que tus Flags, Callbacks, Logic y el guardado
	de config funcionan igual. Lo que cambia es la piel: fondo negro,
	letra monoespaciada, verde "matrix" y bordes casi rectos.

	Colores (cambian SOLO el acento, no el fondo):
		"Verde" (por defecto) | "Lima" | "Ambar" | "Cian" | "Rojo"

	Scroll SIN barrita:
	  • la fila de tabs se mueve ARRASTRANDO con el mouse (o el dedo);
	  • el contenido de la pestaña con la rueda del mouse (o el dedo).

	La ventana se MUEVE arrastrando la barra de arriba (el título).
	No se puede sacar de la pantalla: siempre queda a la vista un pedazo
	de la barra para volver a agarrarla.

	Botón X: cierra la ventana (se encoge hacia su esquina) y aparece un
	círculo con una calavera pixelada que va chorreando píxeles. Tocás el
	círculo y la ventana vuelve a abrirse. (Ya no hay tecla para abrir ni
	cerrar; por código siguen existiendo Window:Show(), :Hide() y :Toggle().)

	MONITOR DE JUGADORES (integrado): agrega una pestaña "Monitor" que marca a
	los jugadores que vuelan, van demasiado rápido, se teletransportan,
	atraviesan paredes o usan animaciones a un ritmo raro. Incluye un modo
	"aprender" por ítem (fruta, espada, melee, arma).
	  • al crear la ventana:  Monitor = true   (o una tabla: Monitor = { AutoStart = true })
	  • o a mano:             Window:CreateMonitor({ AutoStart = true })
	Es una PISTA, no una prueba: puede dar falsos positivos.

	Uso:
		local UI = loadstring(game:HttpGet("...PasteBinHub.lua"))()
		local Window = UI:CreateWindow({
			Title       = "PasteBin Hub",
			Badge       = "v1.0",
			ServerName  = "mi hub",
			Theme       = "Verde",    -- "Verde" | "Lima" | "Ambar" | "Cian" | "Rojo"
			CornerStyle = "Round",    -- "Round" (bordes suaves) | "Sharp" (rectos)
			Width       = 420,
			Height      = 300,
			Draggable   = true,       -- true = se mueve arrastrando la barra de arriba (false = fija)
			ShowOrb     = true,       -- false = al cerrar no aparece el círculo con la calavera
			Monitor     = false,      -- true = agrega la pestaña Monitor (detector de jugadores)
			AutoSaveConfig  = true,
			AutoLoadStagger = 0.1,
			AutoLoadOrder   = {"M", "F", "A"},
			AutoSaveIgnore  = {"MiniPekka"},
		})
		local Combate = Window:CreateTab({ Name = "Combate" })
		Combate:CreateToggle({ Text = "Auto Farm", Flag = "AutoFarm",
			Callback = function(state) ... end })
		Combate:CreateSlider({ Text = "Velocidad", Range = {0, 200}, Default = 16,
			Callback = function(v) ... end })
		Combate:CreateButton({ Text = "Teletransportar", Callback = function() ... end })
		Combate:CreateDropdown({ Text = "Modo", Options = {"Rápido", "Lento"},
			Callback = function(opt) ... end })

		Window:Notify("Auto Farm activado")
		Window:Notify({ Title = "Atención", Text = "Te quedaste sin energía", Duration = 4 })
]]

local TweenService     = game:GetService("TweenService")
local Players          = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local UI = {}
UI.__index = UI
UI.Version    = "1.0"
UI.Windows    = {}
UI.Flags      = {}
UI.FlagValues = {}
UI.ConfigFolder = "PasteBinHub"

local autoSaveTargets = {}
local loadingConfig = false
local autoSaveIgnore = {}
local function isIgnoredFlag(flag)
	local lower = tostring(flag):lower()
	for _, word in ipairs(autoSaveIgnore) do
		if typeof(word) == "string" and word ~= "" and lower:find(word:lower(), 1, true) then
			return true
		end
	end
	return false
end

