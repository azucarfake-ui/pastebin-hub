function UI:CreateButton(config)
	config = config or {}
	local callback = resolveCallback(config)
	local text = config.Text or config.Name or config.Title or "boton"
	local list, window, owner = host(self)
	if not list then return setmetatable({}, Stub) end

	local Btn = new("TextButton", {
		Text = "> " .. text, Font = Theme.Font, TextSize = 12, TextColor3 = Theme.Text, TextTruncate = Enum.TextTruncate.AtEnd,
		TextXAlignment = Enum.TextXAlignment.Left,
		AutoButtonColor = false, BackgroundColor3 = Theme.Field, BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 26), LayoutOrder = nextOrder(owner), Parent = list,
	}, { corner(4), stroke(Theme.Line, 1), pad(0, 0, 8, 0, 10) })
	hoverField(Btn, Theme.Field)

	local Button = setmetatable({ Instance = Btn, Callback = callback, _threads = {} }, UI)
	function Button:Set(...)
		-- Destello verde que se apaga solo.
		Btn.BackgroundColor3 = Theme.ActiveDim
		tween(Btn, { BackgroundColor3 = Theme.LineOpen }, 0.3)
		Btn.TextColor3 = Theme.Active
		task.delay(0.15, function()
			if Btn.Parent then Btn.TextColor3 = Theme.Text end
		end)
		return safeCall(self, self.Callback, ...)
	end
	Button.Fire = Button.Set
	function Button:Stop() stopAllThreads(self) end
	table.insert(window._connections, Btn.MouseButton1Click:Connect(function() Button:Set() end))
	registerFlag(config.Flag, Button, nil)
	return Button
end

function UI:CreateToggle(config)
	config = config or {}
	local callback = resolveCallback(config)
	local state = config.Default
	if state == nil then state = config.CurrentValue end
	if state == nil then state = false end
	state = not not state
	local list, window, owner = host(self)
	if not list then return setmetatable({}, Stub) end

	local Row = new("Frame", { Size = UDim2.new(1, 0, 0, 26), BackgroundColor3 = Theme.Field, BorderSizePixel = 0, LayoutOrder = nextOrder(owner), Parent = list }, { corner(4), stroke(Theme.Line, 1) })
	hoverField(Row, Theme.Field)
	new("TextLabel", {
		Text = config.Text or config.Name or "opcion", Font = Theme.Font, TextSize = 12, TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, BackgroundTransparency = 1,
		Position = UDim2.new(0, 10, 0, 0), Size = UDim2.new(1, -52, 1, 0), Parent = Row,
	})
	-- Apagado: [ ]   Prendido: [x] en verde.
	local Box = new("TextLabel", {
		Text = state and "[x]" or "[ ]", Font = Theme.Font, TextSize = 13, TextColor3 = state and Theme.Active or Theme.TextDim,
		TextXAlignment = Enum.TextXAlignment.Right, BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.new(0, 30, 1, 0), Parent = Row,
	})

	local Toggle = setmetatable({ Box = Box, Value = state, Callback = callback, _threads = {} }, UI)
	onAccent(function() if Box.Parent and Toggle.Value then Box.TextColor3 = Theme.Active end end)

	function Toggle:Set(newState)
		newState = not not newState
		self.Value = newState
		Box.Text = newState and "[x]" or "[ ]"
		tween(Box, { TextColor3 = newState and Theme.Active or Theme.TextDim }, 0.15)
		setFlagValue(config.Flag, newState)
		return safeCall(self, self.Callback, newState)
	end
	function Toggle:Get() return self.Value end
	function Toggle:Stop() stopAllThreads(self) end
	local Click = new("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Parent = Row })
	table.insert(window._connections, Click.MouseButton1Click:Connect(function() Toggle:Set(not Toggle.Value) end))
	registerFlag(config.Flag, Toggle, state)
	return Toggle
end

function UI:CreateSlider(config)
	config = config or {}
	local callback = resolveCallback(config)
	local rangeMin, rangeMax = config.Min, config.Max
	if typeof(config.Range) == "table" then rangeMin = rangeMin or config.Range[1] rangeMax = rangeMax or config.Range[2] end
	local min, max = rangeMin or 0, rangeMax or 100
	if max <= min then max = min + 1 end
	local step = config.Increment or config.Step or 1
	if step <= 0 then step = 1 end
	local decimals = 0
	if step < 1 then decimals = math.min(#tostring(step):gsub("^%d*%.?", ""), 3) end
	local function snap(v) v = math.clamp(v, min, max) return math.clamp(min + math.floor((v - min) / step + 0.5) * step, min, max) end
	local function show(v) if decimals > 0 then return string.format("%." .. decimals .. "f", v) end return tostring(math.floor(v + 0.5)) end
	local value = snap(config.Default or config.CurrentValue or min)

	local list, window, owner = host(self)
	if not list then return setmetatable({}, Stub) end

	local Row = new("Frame", { Size = UDim2.new(1, 0, 0, 38), BackgroundColor3 = Theme.Field, BorderSizePixel = 0, LayoutOrder = nextOrder(owner), Parent = list }, { corner(4), stroke(Theme.Line, 1), pad(0, 5, 10, 5, 10) })
	new("TextLabel", {
		Text = config.Text or config.Name or "valor", Font = Theme.Font, TextSize = 12, TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, BackgroundTransparency = 1,
		Size = UDim2.new(1, -56, 0, 14), Parent = Row,
	})
	local ValueLabel = new("TextLabel", {
		Text = show(value), Font = Theme.Font, TextSize = 12, TextColor3 = Theme.Active, TextXAlignment = Enum.TextXAlignment.Right,
		BackgroundTransparency = 1, Size = UDim2.new(0, 52, 0, 14), Position = UDim2.new(1, -52, 0, 0), Parent = Row,
	})
	onAccent(function() if ValueLabel.Parent then ValueLabel.TextColor3 = Theme.Active end end)
	local Track = new("Frame", { Size = UDim2.new(1, 0, 0, 5), Position = UDim2.new(0, 0, 1, -9), BackgroundColor3 = Theme.Line, BorderSizePixel = 0, Parent = Row }, { corner(2) })
	local function ratio(v) return (v - min) / (max - min) end
	local Fill = new("Frame", { Size = UDim2.new(ratio(value), 0, 1, 0), BackgroundColor3 = Theme.Active, BorderSizePixel = 0, Parent = Track }, { corner(2) })
	onAccent(function() if Fill.Parent then Fill.BackgroundColor3 = Theme.Active end end)
	local Knob = new("Frame", {
		Size = UDim2.new(0, 8, 0, 11), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(ratio(value), 0, 0.5, 0),
		BackgroundColor3 = Theme.Text, BorderSizePixel = 0, Parent = Track,
	}, { corner(2) })
	local KnobPop = new("UIScale", { Scale = 1, Parent = Knob })

	local Slider = setmetatable({ Track = Track, Fill = Fill, Knob = Knob, Value = value, Min = min, Max = max, Callback = callback, _threads = {} }, UI)
	local function repaint(v)
		local r = ratio(v)
		Fill.Size = UDim2.new(r, 0, 1, 0)
		Knob.Position = UDim2.new(r, 0, 0.5, 0)
		ValueLabel.Text = show(v)
	end
	function Slider:Set(newValue, whileDragging)
		newValue = snap(tonumber(newValue) or min)
		self.Value = newValue
		repaint(newValue)
		setFlagValue(config.Flag, newValue, whileDragging)
		return safeCall(self, self.Callback, newValue)
	end
	function Slider:Get() return self.Value end
	function Slider:Stop() stopAllThreads(self) end

	local dragging = false
	local function setFromX(xPos)
		local relative = math.clamp((xPos - Track.AbsolutePosition.X) / math.max(Track.AbsoluteSize.X, 1), 0, 1)
		Slider:Set(min + relative * (max - min), dragging)
	end
	-- Zona de toque más alta que la barrita, para que sea fácil agarrarla.
	local Hit = new("Frame", { Size = UDim2.new(1, 0, 0, 18), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 1, -6), BackgroundTransparency = 1, Parent = Row })
