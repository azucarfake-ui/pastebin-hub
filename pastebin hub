-- Paleta: cambia SOLO el acento (borde/tab activa/relleno de toggles y
-- sliders), no el fondo. Con config.Theme al crear la ventana, o en
-- caliente con UI:SetAccentColor(...).
local Palettes = {
	Verde = Color3.fromRGB(0, 255, 102),
	Lima  = Color3.fromRGB(160, 255, 0),
	Ambar = Color3.fromRGB(255, 176, 0),
	Cian  = Color3.fromRGB(0, 229, 255),
	Rojo  = Color3.fromRGB(255, 70, 70),
}
UI.Palettes = Palettes
UI.CurrentPalette = "Verde"

local accentListeners = {}
local function onAccent(fn)
	table.insert(accentListeners, fn)
	return fn
end

function UI:SetAccentColor(paletteName)
	local color = Palettes[paletteName]
	if not color then
		warn("[PasteBinHub] Color desconocido: " .. tostring(paletteName) .. ". Usá Verde, Lima, Ambar, Cian o Rojo.")
		return
	end
	UI.CurrentPalette = paletteName
	Theme.Border, Theme.Active = color, color
	Theme.ActiveDim = color:Lerp(Color3.new(0, 0, 0), 0.38)
	for _, fn in ipairs(accentListeners) do pcall(fn) end
end

-- ============================================================
-- 	HELPERS DE CONSTRUCCIÓN
-- ============================================================
local function new(class, props, children)
	local inst = Instance.new(class)
	for prop, value in pairs(props or {}) do inst[prop] = value end
	for _, child in ipairs(children or {}) do child.Parent = inst end
	return inst
end

-- Modo de esquinas: "Round" (bordes suaves) o "Sharp" (rectos del todo).
local CornerMode = "Round"
local cornerListeners = {}
local function onCornerChange(fn) table.insert(cornerListeners, fn) return fn end
local function corner(radius)
	radius = radius or 0
	local inst = new("UICorner", { CornerRadius = UDim.new(0, CornerMode == "Round" and radius or 0) })
	onCornerChange(function() inst.CornerRadius = UDim.new(0, CornerMode == "Round" and radius or 0) end)
	return inst
end
function UI:SetCornerStyle(mode)
	if mode ~= "Round" and mode ~= "Sharp" then
		warn("[PasteBinHub] Modo de esquina desconocido: " .. tostring(mode) .. ". Usá \"Round\" o \"Sharp\".")
		return
	end
	CornerMode = mode
	for _, fn in ipairs(cornerListeners) do pcall(fn) end
end
local function stroke(color, thickness) return new("UIStroke", { Color = color or Theme.Border, Thickness = thickness or 1 }) end
local function pad(all, top, right, bottom, left)
	return new("UIPadding", {
		PaddingTop = UDim.new(0, top or all or 0), PaddingRight = UDim.new(0, right or all or 0),
		PaddingBottom = UDim.new(0, bottom or all or 0), PaddingLeft = UDim.new(0, left or all or 0),
	})
end
local function tween(inst, props, time, style, dir)
	TweenService:Create(inst, TweenInfo.new(time or 0.15, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props):Play()
	return inst
end

-- Barrita de acento que se enciende a la izquierda de una fila al pasar
-- el mouse. Dura una fracción de segundo: no queda nada corriendo.
local function hoverField(obj, base)
	base = base or Theme.Field
	local mark = new("Frame", {
		Size = UDim2.new(0, 2, 0.4, 0), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
		BackgroundColor3 = Theme.Active, BackgroundTransparency = 1, BorderSizePixel = 0, Parent = obj,
	})
	onAccent(function() if mark.Parent then mark.BackgroundColor3 = Theme.Active end end)
	obj.MouseEnter:Connect(function()
		tween(obj, { BackgroundColor3 = Theme.LineOpen })
		tween(mark, { BackgroundTransparency = 0, Size = UDim2.new(0, 2, 0.8, 0) }, 0.12)
	end)
	obj.MouseLeave:Connect(function()
		tween(obj, { BackgroundColor3 = base })
		tween(mark, { BackgroundTransparency = 1, Size = UDim2.new(0, 2, 0.4, 0) }, 0.12)
	end)
end

-- ============================================================
-- 	NÚCLEO: CALLBACKS EN HILOS INDEPENDIENTES + FLAGS
-- ============================================================
local function safeCall(controller, fn, ...)
	fn = fn or function() end
	if typeof(fn) ~= "function" then return nil end
	local args = table.pack(...)
	if controller then controller._threads = controller._threads or {} end

	return task.spawn(function()
		local thisThread = coroutine.running()
		if controller then controller._threads[thisThread] = true end
		local ok, err = pcall(function() fn(table.unpack(args, 1, args.n)) end)
		if not ok then
			warn("[PasteBinHub] Error en tu callback: " .. tostring(err))
		end
		if controller and controller._threads then controller._threads[thisThread] = nil end
	end)
end
local function stopAllThreads(controller)
	if not controller._threads then return end
	for th in pairs(controller._threads) do pcall(task.cancel, th) end
	controller._threads = {}
end
local function resolveCallback(config)
	if typeof(config.Callback) == "function" then return config.Callback end
	local logic = config.Logic
	if logic == nil then return function() end end
	if typeof(logic) == "function" then return logic end
	if typeof(logic) == "table" then
		return function(value)
			if typeof(value) == "boolean" then
				if value and typeof(logic.Enable) == "function" then logic.Enable() return end
				if not value and typeof(logic.Disable) == "function" then logic.Disable() return end
			end
			if typeof(logic.Toggle) == "function" then logic.Toggle(value)
			elseif typeof(logic.Set) == "function" then logic.Set(value)
			elseif typeof(logic.Run) == "function" then logic.Run(value)
			else warn("[PasteBinHub] La tabla en Logic no tiene :Toggle/:Enable+Disable/:Set/:Run.") end
		end
	end
	return function() end
end
local function registerFlag(flagName, controller, initialValue)
	if not flagName then return end
	UI.Flags[flagName] = controller
	UI.FlagValues[flagName] = initialValue
end
local function setFlagValue(flagName, value, skipSave)
	if flagName == nil then return end
	UI.FlagValues[flagName] = value
	if not skipSave and not loadingConfig and next(autoSaveTargets) ~= nil then
		for name in pairs(autoSaveTargets) do UI:SaveConfig(name) end
	end
end
local function nextOrder(owner)
	owner._rowCount = (owner._rowCount or 0) + 1
	return owner._rowCount
end
local function host(self)
	if self.List then return self.List, (self.Window or self), self end
	if self._tabs and self._tabs[1] then
		warn("[PasteBinHub] Creaste un control sobre la ventana en vez de sobre una pestaña. Se agregó a la primera pestaña.")
		return self._tabs[1].List, self, self._tabs[1]
	end
	return nil, (self.Window or self), self
end

-- ============================================================
-- 	DÓNDE COLGAR LA UI + LIMPIEZA DE EJECUCIONES ANTERIORES
-- ============================================================
local function getGuiParent()
	local getHui = rawget(_G, "gethui")
	if typeof(getHui) == "function" then
		local ok, hui = pcall(getHui)
		if ok and hui then return hui end
	end
	local okCore, coreGui = pcall(function() return game:GetService("CoreGui") end)
	if okCore and coreGui then
		if pcall(function() local p = Instance.new("Folder") p.Parent = coreGui p:Destroy() end) then
			return coreGui
		end
	end
	local player = Players.LocalPlayer or Players.PlayerAdded:Wait()
	return player:WaitForChild("PlayerGui")
end

local LOAD_ID = tostring(os.clock()) .. "-" .. tostring(math.random(1, 1000000000))
local function cleanupOldWindows(guiParent)
	local registry = rawget(_G, "__PasteBinHubWindows")
	if typeof(registry) == "table" then
		for i = #registry, 1, -1 do
			local w = registry[i]
			if typeof(w) == "table" and w._loadId ~= LOAD_ID then
				pcall(function() w:Destroy() end)
				table.remove(registry, i)
			end
		end
	end
	local places = { guiParent }
	local plr = Players.LocalPlayer
	if plr and plr:FindFirstChild("PlayerGui") then table.insert(places, plr.PlayerGui) end
	pcall(function() table.insert(places, game:GetService("CoreGui")) end)
	for _, place in ipairs(places) do
		pcall(function()
			for _, child in ipairs(place:GetChildren()) do
				if child:IsA("ScreenGui") and child.Name == "PasteBinHub"
					and child:GetAttribute("PasteBinLoadId") ~= LOAD_ID then
					child:Destroy()
				end
			end
		end)
	end
end

-- ============================================================
-- 	CREATE WINDOW — el rectángulo
-- ============================================================
function UI:CreateWindow(config)
	config = config or {}

	if config.CornerStyle ~= nil then UI:SetCornerStyle(config.CornerStyle) end
	if config.Theme ~= nil then UI:SetAccentColor(config.Theme) end

	local title = config.Title or config.Name or "PasteBin Hub"
	local W = config.Width or WINDOW_W
	local H = config.Height or WINDOW_H
	local RADIUS = 8

	local subtitleParts = {}
	if config.Badge and tostring(config.Badge) ~= "" then table.insert(subtitleParts, tostring(config.Badge)) end
	if config.ServerName and tostring(config.ServerName) ~= "" then table.insert(subtitleParts, tostring(config.ServerName)) end
	local subtitleText = table.concat(subtitleParts, "  |  ")
	local HEADER_H = (subtitleText ~= "" and 42) or 30

	local ScreenGui = new("ScreenGui", {
		Name = "PasteBinHub", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 999, IgnoreGuiInset = config.IgnoreGuiInset ~= false,
	})
	local protectGui = rawget(_G, "protectgui") or rawget(_G, "protect_gui")
	if typeof(protectGui) == "function" then pcall(protectGui, ScreenGui) end
	local guiParent = getGuiParent()
	cleanupOldWindows(guiParent)
	ScreenGui:SetAttribute("PasteBinLoadId", LOAD_ID)
	ScreenGui.Parent = guiParent

	-- Posición por defecto: IZQUIERDA de la pantalla. Pasá config.Position
	-- si querés ubicarla en cualquier otro lado.
	local defaultPanelPos = UDim2.new(0, 24, 0.5, -H / 2)

	-- ---------------- EL RECTÁNGULO ----------------
	-- CanvasGroup: dibuja fondo + controles juntos con UNA sola
	-- transparencia y recorta todo a las esquinas redondeadas.
	local Panel = new("CanvasGroup", {
		Name = "Panel", Size = UDim2.new(0, W, 0, H),
		Position = config.Position or defaultPanelPos,
		BackgroundColor3 = Theme.Background, GroupTransparency = Theme.Alpha,
		BorderSizePixel = 0, ClipsDescendants = true, ZIndex = 2, Parent = ScreenGui,
	}, { corner(RADIUS), stroke(Theme.Border, 1.5) })
	local PanelStroke = Panel:FindFirstChildOfClass("UIStroke")
	local PanelScale = new("UIScale", { Scale = 1, Parent = Panel }) -- se usa al cerrar/abrir
	onAccent(function() if PanelStroke and PanelStroke.Parent then PanelStroke.Color = Theme.Border end end)

	-- Barra superior: "> Título_" + Badge/ServerName + reloj.
	local TopBar = new("Frame", { Size = UDim2.new(1, 0, 0, HEADER_H), BackgroundColor3 = Theme.Panel, BorderSizePixel = 0, Parent = Panel })
	local TitleLabel = new("TextLabel", {
		Text = "> " .. title .. "_", Font = Theme.Font, TextSize = 14, TextColor3 = Theme.Active,
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextTruncate = Enum.TextTruncate.AtEnd,
		BackgroundTransparency = 1, Position = UDim2.new(0, 10, 0, 5), Size = UDim2.new(1, -110, 0, 18), Parent = TopBar,
	})
	onAccent(function() if TitleLabel.Parent then TitleLabel.TextColor3 = Theme.Active end end)
	if subtitleText ~= "" then
		new("TextLabel", {
			Text = "// " .. subtitleText, Font = Theme.Font, TextSize = 11, TextColor3 = Theme.TextDim,
			TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
			BackgroundTransparency = 1, Position = UDim2.new(0, 10, 0, 23), Size = UDim2.new(1, -50, 0, 14), Parent = TopBar,
		})
	end
	local ClockLabel = new("TextLabel", {
		Text = os.date("%H:%M:%S"), Font = Theme.Font, TextSize = 12, TextColor3 = Theme.TextDim,
		TextXAlignment = Enum.TextXAlignment.Right, TextYAlignment = Enum.TextYAlignment.Top, BackgroundTransparency = 1,
		Position = UDim2.new(1, -96, 0, 6), Size = UDim2.new(0, 58, 0, 16), Parent = TopBar,
	})
	task.spawn(function() while ClockLabel.Parent do ClockLabel.Text = os.date("%H:%M:%S") task.wait(1) end end)
	-- Línea fina bajo la barra de arriba.
	local TopLine = new("Frame", { Size = UDim2.new(1, 0, 0, 1), Position = UDim2.new(0, 0, 1, -1), BackgroundColor3 = Theme.ActiveDim, BorderSizePixel = 0, Parent = TopBar })
	onAccent(function() if TopLine.Parent then TopLine.BackgroundColor3 = Theme.ActiveDim end end)

	-- Botón X: cierra la ventana. Se deshace en bloques que vuelan a un
	-- círculo con una calavera pixelada; tocás el círculo y se rearma.
	local CloseBtn = new("TextButton", {
		Text = "X", Font = Theme.Font, TextSize = 13, TextColor3 = Theme.TextDim, AutoButtonColor = false,
		BackgroundColor3 = Theme.Field, BorderSizePixel = 0, Size = UDim2.new(0, 24, 0, 20),
		AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 5), Parent = TopBar,
	}, { corner(4), stroke(Theme.Line, 1) })
	CloseBtn.MouseEnter:Connect(function() CloseBtn.TextColor3 = Theme.Active tween(CloseBtn, { BackgroundColor3 = Theme.LineOpen }, 0.1) end)
	CloseBtn.MouseLeave:Connect(function() CloseBtn.TextColor3 = Theme.TextDim tween(CloseBtn, { BackgroundColor3 = Theme.Field }, 0.1) end)

	-- Fila de tabs: horizontal, sin barra de scroll. Se mueve arrastrando.
	local TabStrip = new("ScrollingFrame", {
		Name = "TabStrip", Position = UDim2.new(0, 0, 0, HEADER_H), Size = UDim2.new(1, 0, 0, TAB_STRIP_H),
		BackgroundColor3 = Theme.Panel, BorderSizePixel = 0, ScrollBarThickness = 0, ScrollBarImageTransparency = 1,
		ScrollingEnabled = false, ScrollingDirection = Enum.ScrollingDirection.X, CanvasSize = UDim2.new(0, 0, 0, 0),
		ClipsDescendants = true, ZIndex = 3, Parent = Panel,
	})

	-- Contenido: debajo de los tabs, vertical, sin barra (rueda o dedo).
	local ContentScroll = new("ScrollingFrame", {
		Name = "Content", Position = UDim2.new(0, 8, 0, HEADER_H + TAB_STRIP_H + 6), Size = UDim2.new(1, -16, 1, -(HEADER_H + TAB_STRIP_H + 14)),
		BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 0, ScrollBarImageTransparency = 1,
		CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = Panel,
	})
	new("UIListLayout", { Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder, Parent = ContentScroll })

	local EmptyHint = new("TextLabel", {
		Text = "$ sin pestañas. Usá Window:CreateTab({ Name = \"...\" })", Font = Theme.Font, TextSize = 12,
		TextColor3 = Theme.TextDim, TextWrapped = true, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 34), Parent = ContentScroll,
	})

	local Window = setmetatable({
		ScreenGui = ScreenGui, Panel = Panel,
		TabStrip = TabStrip, ContentScroll = ContentScroll, EmptyHint = EmptyHint,
		_tabs = {}, _tabX = 8, _connections = {}, _visible = true, _loadId = LOAD_ID,
		_loadStagger = config.AutoLoadStagger or 0, _loadOrder = config.AutoLoadOrder,
		W = W, H = H,
	}, UI)

	local function track(conn) table.insert(Window._connections, conn) return conn end

	-- Arrastrar la fila de tabs con el mouse o el dedo. Si se arrastró, el
	-- click de soltar NO cambia de pestaña (Window._dragMoved).
	local dragKind, dragStartPos, canvasStartX = nil, Vector2.new(0, 0), 0
	Window._dragMoved = false
	local function beginTabDrag(input)
		local kind = input.UserInputType
		if kind ~= Enum.UserInputType.MouseButton1 and kind ~= Enum.UserInputType.Touch then return end
		Window._dragMoved = false
		dragKind = kind
		dragStartPos = Vector2.new(input.Position.X, input.Position.Y)
		canvasStartX = TabStrip.CanvasPosition.X
	end
	Window._beginTabDrag = beginTabDrag
	track(TabStrip.InputBegan:Connect(beginTabDrag))
	track(UserInputService.InputChanged:Connect(function(input)
		if not dragKind then return end
		local kind = input.UserInputType
		if kind ~= Enum.UserInputType.MouseMovement and kind ~= Enum.UserInputType.Touch then return end
		local dx = input.Position.X - dragStartPos.X
		if math.abs(dx) > 6 then Window._dragMoved = true end
		if Window._dragMoved then
			TabStrip.CanvasPosition = Vector2.new(canvasStartX - dx, 0)
		end
	end))
	track(UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragKind = nil
		end
	end))

	-- Mover la ventana: arrastrando la barra de arriba (el título).
	-- Viene ACTIVADO por defecto; config.Draggable = false la deja fija.
	-- Se limita a la pantalla: siempre queda a la vista un pedazo de la
	-- barra de arriba para poder volver a agarrarla.
	if config.Draggable ~= false then
		local moving, moveStart, panelStart = false, nil, nil
		track(TopBar.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				moving, moveStart, panelStart = true, input.Position, Panel.AbsolutePosition
			end
		end))
		track(UserInputService.InputChanged:Connect(function(input)
			if moving and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				local d = input.Position - moveStart
				local screen = ScreenGui.AbsoluteSize
				local size = Panel.AbsoluteSize
				local x = math.clamp(panelStart.X + d.X, 60 - size.X, screen.X - 60)
				local y = math.clamp(panelStart.Y + d.Y, 0, math.max(screen.Y - HEADER_H, 0))
				Panel.Position = UDim2.fromOffset(x, y)
			end
		end))
		track(UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				moving = false
			end
		end))
	end

	-- Círculo con la calavera: aparece cuando se cierra la ventana y va
	-- chorreando píxeles. Tocarlo reabre la ventana.
	table.insert(Window._connections, CloseBtn.MouseButton1Click:Connect(function() Window:Hide() end))
	Window._panelScale = PanelScale
	if config.ShowOrb ~= false then
		local Orb = new("Frame", {
			Name = "Orb", Visible = false, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 60, 0, 60),
			Size = UDim2.new(0, ORB_SIZE, 0, ORB_SIZE), BackgroundColor3 = Theme.Background, BorderSizePixel = 0,
			ZIndex = 60, Parent = ScreenGui,
		}, { new("UICorner", { CornerRadius = UDim.new(1, 0) }) })
		local OrbStroke = stroke(Theme.Border, 2)
		OrbStroke.Parent = Orb
		local OrbScale = new("UIScale", { Scale = 1, Parent = Orb })
		local Skull = new("Frame", {
			Size = UDim2.new(0, #SKULL[1] * ORB_PIXEL, 0, #SKULL * ORB_PIXEL), AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0.5, 0), BackgroundTransparency = 1, Parent = Orb,
		})

		local SKULL_COLOR = { ["#"] = "Active", o = "ActiveDim", h = "Text", p = "Active" }
		local skullPixels = {}
		for r, rowStr in ipairs(SKULL) do
			for c = 1, #rowStr do
				local key = SKULL_COLOR[rowStr:sub(c, c)]
				if key then
					table.insert(skullPixels, {
						key = key,
						frame = new("Frame", {
							Size = UDim2.new(0, ORB_PIXEL, 0, ORB_PIXEL),
							Position = UDim2.new(0, (c - 1) * ORB_PIXEL, 0, (r - 1) * ORB_PIXEL),
							BackgroundColor3 = Theme[key], BorderSizePixel = 0, Parent = Skull,
						}),
					})
				end
			end
		end
		onAccent(function()
			if not Orb.Parent then return end
			OrbStroke.Color = Theme.Border
			for _, sp in ipairs(skullPixels) do sp.frame.BackgroundColor3 = Theme[sp.key] end
		end)

		-- Chorreo: de la parte de abajo de la calavera (mandíbula y mejillas)
		-- se estiran gotitas de pixeles que se sueltan, caen fuera del
		-- círculo y se apagan. Solo corre mientras el círculo está a la vista.
		local dripSources = {}
		for c = 1, #SKULL[1] do
			for r = #SKULL, 1, -1 do
				local ch = SKULL[r]:sub(c, c)
				if ch ~= "." and ch ~= "e" and ch ~= "n" then
					table.insert(dripSources, { x = (c - 1) * ORB_PIXEL, y = r * ORB_PIXEL })
					break
				end
			end
		end
		local function spawnDrip()
			local src = dripSources[math.random(#dripSources)]
			for i = 1, math.random(1, 3) do
				task.delay((i - 1) * 0.1, function()
					if not Skull.Parent or not Orb.Visible then return end
					local drop = new("Frame", {
						Size = UDim2.new(0, ORB_PIXEL, 0, ORB_PIXEL), Position = UDim2.new(0, src.x, 0, src.y - ORB_PIXEL),
						BackgroundColor3 = (math.random() < 0.3) and Theme.ActiveDim or Theme.Active,
						BorderSizePixel = 0, ZIndex = 2, Parent = Skull,
					})
					-- se estira hacia abajo como una gota que se despega...
					TweenService:Create(drop, TweenInfo.new(0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
						Size = UDim2.new(0, ORB_PIXEL, 0, ORB_PIXEL * 3),
					}):Play()
					-- ...se suelta, cae acelerando y se apaga
					task.delay(0.3, function()
						if not drop.Parent then return end
						local fall = 30 + math.random() * 34
						local dur = 0.7 + math.random() * 0.5
						TweenService:Create(drop, TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
							Position = UDim2.new(0, src.x, 0, src.y + fall), Size = UDim2.new(0, ORB_PIXEL, 0, ORB_PIXEL),
							BackgroundTransparency = 1,
						}):Play()
						task.delay(dur + 0.05, function() if drop.Parent then drop:Destroy() end end)
					end)
				end)
			end
		end
		local dripToken = 0
		Window._startDrips = function()
			dripToken = dripToken + 1
			local token = dripToken
			task.spawn(function()
				while token == dripToken and Orb.Parent and Orb.Visible do
					spawnDrip()
					task.wait(0.2 + math.random() * 0.4)
				end
			end)
		end

		local OrbBtn = new("TextButton", { Text = "", AutoButtonColor = false, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Parent = Orb })
		OrbBtn.MouseEnter:Connect(function() if not Window._busy then tween(OrbScale, { Scale = 1.1 }, 0.1) end end)
		OrbBtn.MouseLeave:Connect(function() if not Window._busy then tween(OrbScale, { Scale = 1 }, 0.1) end end)
		table.insert(Window._connections, OrbBtn.MouseButton1Click:Connect(function() Window:Show() end))
		Window._orb, Window._orbScale = Orb, OrbScale
	end

	table.insert(UI.Windows, Window)
	local registry = rawget(_G, "__PasteBinHubWindows")
	if typeof(registry) ~= "table" then registry = {} rawset(_G, "__PasteBinHubWindows", registry) end
	table.insert(registry, Window)

	-- ---------------- Guardado/carga de configuración ----------------
	if typeof(config.AutoSaveIgnore) == "table" then
		for _, word in ipairs(config.AutoSaveIgnore) do table.insert(autoSaveIgnore, word) end
	end
	local autoName = config.AutoSaveConfig
	if autoName == true then autoName = "default" end
	if typeof(autoName) == "string" and autoName ~= "" then
		autoSaveTargets[autoName] = true
		if config.AutoLoadConfig ~= false then
			local delay = config.AutoLoadDelay or 0
			task.spawn(function()
				task.wait()
				if delay > 0 then task.wait(delay) end
				Window:LoadConfig(autoName)
			end)
		end
	end

	-- Monitor = true (o una tabla de opciones) agrega la pestaña Monitor.
	-- Se crea "diferida", así queda DESPUÉS de las pestañas que crees tú.
	if config.Monitor then
		local monitorOptions = typeof(config.Monitor) == "table" and config.Monitor or nil
		task.defer(function()
			local ok, err = pcall(function() Window:CreateMonitor(monitorOptions) end)
			if not ok then warn("[PasteBinHub] No se pudo crear el Monitor: " .. tostring(err)) end
		end)
	end

	return Window
end

-- Show/Hide con animación corta: la ventana se encoge hacia su esquina de
-- arriba a la izquierda y aparece el círculo con la calavera (que chorrea
-- píxeles). Show(true) / Hide(true) = instantáneo y sin círculo.
function UI:Show(silent)
	if self._visible or self._busy then return end
	self._visible = true
	local Panel, PS, Orb, OrbScale = self.Panel, self._panelScale, self._orb, self._orbScale
	if silent then
		Panel.Visible = true
		if Orb then Orb.Visible = false end
		return
	end
	self._busy = true
	task.spawn(function()
		-- el círculo se achica y la ventana crece desde su esquina
		if Orb and Orb.Visible then
			tween(OrbScale, { Scale = 0.01 }, 0.16, Enum.EasingStyle.Back, Enum.EasingDirection.In)
			task.wait(0.17)
			Orb.Visible = false
			OrbScale.Scale = 1
		end
		PS.Scale = 0.04
		Panel.GroupTransparency = 1
		Panel.Visible = true
		tween(PS, { Scale = 1 }, 0.32, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		tween(Panel, { GroupTransparency = Theme.Alpha }, 0.25)
		task.wait(0.34)
		PS.Scale = 1
		Panel.GroupTransparency = Theme.Alpha
		self._busy = false
	end)
end
function UI:Hide(silent)
	if not self._visible or self._busy then return end
	self._visible = false
	local Panel, PS, Orb, OrbScale = self.Panel, self._panelScale, self._orb, self._orbScale
	if silent then
		Panel.Visible = false
		if Orb then Orb.Visible = false end
		return
	end
	self._busy = true
	task.spawn(function()
		-- el círculo queda arriba a la izquierda de donde estaba la ventana
		local abs = Panel.AbsolutePosition
		if Orb then Orb.Position = UDim2.fromOffset(abs.X + ORB_SIZE / 2 + 10, abs.Y + ORB_SIZE / 2 + 10) end
		tween(PS, { Scale = 0.04 }, 0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		tween(Panel, { GroupTransparency = 1 }, 0.28)
		task.wait(0.3)
		Panel.Visible = false
		PS.Scale = 1
		Panel.GroupTransparency = Theme.Alpha
		if Orb then
			Orb.Visible = true
			OrbScale.Scale = 0.2
			tween(OrbScale, { Scale = 1 }, 0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
			if self._startDrips then self._startDrips() end
		end
		self._busy = false
	end)
end
function UI:Toggle() if self._visible then self:Hide() else self:Show() end end
function UI:Destroy()
	if self._monitorStop then pcall(self._monitorStop) end
	for _, conn in ipairs(self._connections or {}) do pcall(function() conn:Disconnect() end) end
	if self.ScreenGui then pcall(function() self.ScreenGui:Destroy() end) end
	for i, w in ipairs(UI.Windows) do if w == self then table.remove(UI.Windows, i) break end end
end

