-- 	GUARDAR / CARGAR CONFIGURACIÓN
-- ============================================================
local function ensureConfigFolder()
	if typeof(isfolder) == "function" and typeof(makefolder) == "function" then
		if not isfolder(UI.ConfigFolder) then pcall(makefolder, UI.ConfigFolder) end
	end
end

function UI:SaveConfig(name)
	name = name or "default"
	if typeof(writefile) ~= "function" then
		warn("[PasteBinHub] Tu ejecutor no tiene writefile — no se puede guardar la config.")
		return false
	end
	ensureConfigFolder()
	local data = {}
	for flag, value in pairs(UI.FlagValues) do
		if not isIgnoredFlag(flag) then
			local t = typeof(value)
			if t == "boolean" or t == "number" or t == "string" then data[flag] = value
			elseif t == "EnumItem" and value.Name then data[flag] = { __keycode = value.Name } end
		end
	end
	local okJson, encoded = pcall(function() return game:GetService("HttpService"):JSONEncode(data) end)
	if not okJson then warn("[PasteBinHub] No se pudo convertir la config a JSON.") return false end
	local okWrite, err = pcall(writefile, UI.ConfigFolder .. "/" .. name .. ".json", encoded)
	if not okWrite then warn("[PasteBinHub] No se pudo guardar la config: " .. tostring(err)) return false end
	return true
end

function UI:LoadConfig(name, stagger)
	name = name or "default"
	if stagger == nil then stagger = self._loadStagger or 0 end
	if typeof(readfile) ~= "function" or typeof(isfile) ~= "function" then
		warn("[PasteBinHub] Tu ejecutor no tiene readfile/isfile — no se puede cargar la config.")
		return false
	end
	local path = UI.ConfigFolder .. "/" .. name .. ".json"
	if not isfile(path) then return false end
	local okRead, raw = pcall(readfile, path)
	if not okRead then warn("[PasteBinHub] No se pudo leer el archivo de config.") return false end
	local okJson, data = pcall(function() return game:GetService("HttpService"):JSONDecode(raw) end)
	if not okJson or typeof(data) ~= "table" then warn("[PasteBinHub] La config guardada está corrupta o vacía.") return false end

	local order = self._loadOrder
	local function priority(flag)
		if typeof(order) == "table" then
			local first = flag:sub(1, 1):upper()
			for i, letter in ipairs(order) do
				if typeof(letter) == "string" and first == letter:sub(1, 1):upper() then return i end
			end
		end
		return math.huge
	end
	local flags = {}
	for flag in pairs(data) do if not isIgnoredFlag(flag) then table.insert(flags, flag) end end
	table.sort(flags, function(a, b)
		local pa, pb = priority(a), priority(b)
		if pa ~= pb then return pa < pb end
		return a < b
	end)

	loadingConfig = true
	local ok = pcall(function()
		for i, flag in ipairs(flags) do
			local value = data[flag]
			local controller = UI.Flags[flag]
			if controller and typeof(controller.Set) == "function" then
				if typeof(value) == "table" and value.__keycode then
					local okKey, keyCode = pcall(function() return Enum.KeyCode[value.__keycode] end)
					if okKey and keyCode then controller:Set(keyCode) end
				else
					pcall(function() controller:Set(value) end)
				end
			end
			if stagger > 0 and i < #flags then task.wait(stagger) end
		end
	end)
	loadingConfig = false
	if not ok then warn("[PasteBinHub] Ocurrió un error aplicando la config guardada.") return false end
	return true
end

function UI:ListConfigs()
	if typeof(listfiles) ~= "function" or typeof(isfolder) ~= "function" then return {} end
	if not isfolder(UI.ConfigFolder) then return {} end
	local names = {}
	local okList, files = pcall(listfiles, UI.ConfigFolder)
	if not okList then return names end
	for _, path in ipairs(files) do
		local fname = path:match("([^/\\]+)%.json$")
		if fname then table.insert(names, fname) end
	end
	return names
end

-- ============================================================
-- 	MONITOR DE JUGADORES (integrado)
-- ============================================================
-- Window:CreateMonitor({ AutoStart = false, TabName = "Monitor" })
-- Crea una pestaña que marca a los jugadores que vuelan, van demasiado
-- rápido, se teletransportan, atraviesan paredes o usan animaciones a
-- un ritmo raro. Tiene un modo "aprender" por ítem (se guarda en
-- PlayerMonitor/learned.json). Es una PISTA, no una prueba.
function UI:CreateMonitor(options)
    local window = self
    options = options or {}
    if type(rawget(_G, "__PlayerMonitorStop")) == "function" then pcall(_G.__PlayerMonitorStop) end
    local Players = game:GetService("Players")
    local HttpService = game:GetService("HttpService")
    local lp = Players.LocalPlayer

    local FOLDER, FILE = "PlayerMonitor", "PlayerMonitor/learned.json"
    local cfg = {
        on = false, notify = true, tags = false, learn = false, far = false, noclip = true,
        maxSpeed = 90, flyTime = 2.5, tpDist = 200, step = 0.2,
        animRate = 7, animRepeat = 5, paceFactor = 0.6, farDist = 600,
        swapRate = 5, spinSpeed = 700, maxWalk = 70, maxJump = 120, effectRate = 120, effects = false,
        ignore = {}, swapOn = true,
    }
    local KINDS = { "Flying?", "Speed?", "Teleport?", "Noclip?", "FastAttack?", "FastItem?", "FarEffect?",
        "SwapSpam?", "Spin?", "Stats?", "EffectSpam?" }
    -- cuanto pesa cada aviso en la nota de sospecha (0-100)
    local WEIGHT = { ["Flying?"] = 12, ["Speed?"] = 10, ["Teleport?"] = 14, ["Noclip?"] = 10, ["FastAttack?"] = 12,
        ["FastItem?"] = 12, ["FarEffect?"] = 8, ["SwapSpam?"] = 10, ["Spin?"] = 8, ["Stats?"] = 14, ["EffectSpam?"] = 8 }

    local data = {}                 -- [player] = estado
    local log = {}                  -- ultimos avisos
    local learned = { items = {} }  -- items[tool][animId] = { gap, hs, air, n }
    local recentCasts = {}          -- [player] = ultimo momento en que lanzo una accion
    local gen, running, alive = 0, false, true
    local conns, farConn, selfConn = {}, nil, nil
    local selfD = { airT = 0, hs = 0, vs = 0, lastStart = {}, seen = setmetatable({}, { __mode = "k" }) }

    -- ---------------------------------------------------------
    --  avisos y registro
    -- ---------------------------------------------------------
    local function say(title, text)
        if window and window.Notify then
            pcall(function() window:Notify({ Title = title, Text = text, Duration = 4 }) end)
        else
            warn("[Monitor] " .. title .. ": " .. text)
        end
    end

    local function getData(p)
        local d = data[p]
        if not d then
            d = {
                score = {}, flash = {}, lastNotify = {}, airT = 0, hs = 0, vs = 0, rate = 0,
                status = "-", anims = {}, lastStart = {}, pace = {},
                peakHs = 0, peakVs = 0, peakRate = 0, peakTool = "-", attacks = 0, fastFlags = 0, tools = {}, events = {},
                uses = {}, counts = {}, swaps = {}, held = nil, swapN = 0, spin = 0, peakSpin = 0, look = nil,
                fx = {}, fxRate = 0, peakFx = 0, lastFx = nil, since = os.clock(), peakWalk = 0,
                seen = setmetatable({}, { __mode = "k" }),
            }
            data[p] = d
        end
        return d
    end

    -- el contador sube mientras se cumple y baja si no: un tiron de lag no marca a nadie
    local function bump(d, kind, cond)
        local s = d.score[kind] or 0
        if cond then s = math.min(s + 1, 10) else s = math.max(s - 0.5, 0) end
        d.score[kind] = s
        return s >= 5
    end

    -- ---------------------------------------------------------
    --  utilidades
    -- ---------------------------------------------------------
    local function toolName(char)
        local t = char and char:FindFirstChildOfClass("Tool")
        return t and t.Name or "_none"
    end

    local function animId(track)
        local ok, id = pcall(function() return track.Animation and track.Animation.AnimationId end)
        if ok and typeof(id) == "string" and id ~= "" then return id end
        return nil
    end

    -- solo animaciones de ACCION y que no se repiten en bucle (ataques, habilidades)
    local function isAction(track)
        local ok, res = pcall(function()
            if track.Looped then return false end
            local pri = track.Priority
            return pri ~= Enum.AnimationPriority.Idle and pri ~= Enum.AnimationPriority.Movement
                and pri ~= Enum.AnimationPriority.Core
        end)
        return ok and res
    end

    local function shortId(id) return id:match("%d+") or id end

    local TIP = { ["Blox Fruit"] = "Fruit", Melee = "Melee", Sword = "Sword", Gun = "Gun" }

    -- lo que tiene en la mano: nombre y categoria (Fruit / Sword / Melee / Gun)
    local function heldTool(char)
        local t = char and char:FindFirstChildOfClass("Tool")
        if not t then return nil, nil end
        return t.Name, TIP[t.ToolTip] or (t.ToolTip ~= "" and t.ToolTip or "Item")
    end

    local function fmtPos(v) return v and string.format("%.0f, %.0f, %.0f", v.X, v.Y, v.Z) or "?" end

    local function compact(n)
        n = tonumber(n)
        if not n then return "?" end
        if n >= 1e9 then return string.format("%.2fB", n / 1e9) end
        if n >= 1e6 then return string.format("%.2fM", n / 1e6) end
        if n >= 1e3 then return string.format("%.1fK", n / 1e3) end
        return string.format("%.0f", n)
    end

    local function valueOf(parent, name)
        local o = parent and parent:FindFirstChild(name)
        if not o then return nil end
        local ok, v = pcall(function() return o.Value end)
        return ok and v or nil
    end

    -- nivel, raza, fruta y bounty salen de las carpetas del juego (Data y leaderstats)
    local function playerInfo(p)
        local info, ls = p:FindFirstChild("Data"), p:FindFirstChild("leaderstats")
        return valueOf(info, "Level"), valueOf(info, "Race"), valueOf(info, "DevilFruit"),
            valueOf(ls, "Bounty/Honor") or valueOf(ls, "Bounty")
    end

    local function isV4(char)
        local o = char and char:FindFirstChild("RaceTransformed")
        return (o and o:IsA("ValueBase") and o.Value == true) or (char and char:GetAttribute("RaceTransformed") == true) or false
    end

    -- ---------------------------------------------------------
    --  avisos y registro (con coordenadas y lo que llevaba en la mano)
    -- ---------------------------------------------------------
    local function addLog(name, kind, detail)
        log[#log + 1] = { t = os.date("%H:%M:%S"), name = name, kind = kind, detail = detail }
        if #log > 100 then table.remove(log, 1) end
    end

    local function raise(p, d, kind, detail)
        local now = os.clock()
        d.flash[kind] = now + 4
        if now - (d.lastNotify[kind] or -99) > 15 then
            d.lastNotify[kind] = now
            local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
            local tn, tc = heldTool(p.Character)
            local full = detail .. " | pos " .. fmtPos(hrp and hrp.Position) .. (tn and (" | " .. tc .. ": " .. tn) or "")
            if kind == "FastAttack?" or kind == "FastItem?" then d.fastFlags = d.fastFlags + 1 end
            d.counts[kind] = (d.counts[kind] or 0) + 1
            addLog(p.Name, kind, full)
            d.events[#d.events + 1] = { t = os.date("%H:%M:%S"), kind = kind, detail = full }
            if #d.events > 8 then table.remove(d.events, 1) end
            if cfg.notify then say(p.Name, kind .. " " .. full) end
        end
    end

    local function buildFilter()
        local ignore = {}
        for _, pl in ipairs(Players:GetPlayers()) do
            if pl.Character then ignore[#ignore + 1] = pl.Character end
        end
        for _, name in ipairs({ "Enemies", "Characters", "NPCs" }) do
            local f = workspace:FindFirstChild(name)
            if f then ignore[#ignore + 1] = f end
        end
        local ray = RaycastParams.new()
        ray.FilterType = Enum.RaycastFilterType.Exclude
        ray.FilterDescendantsInstances = ignore
        local ov = OverlapParams.new()
        ov.FilterType = Enum.RaycastFilterType.Exclude
        ov.FilterDescendantsInstances = ignore
        return { ray = ray, ov = ov }
    end

    -- calcula velocidad horizontal, vertical y tiempo en el aire; devuelve el salto de posicion
    local function measure(d, hrp, hum, now, filter)
        local pos = hrp.Position
        local dt = d.lastT and (now - d.lastT) or 0
        d.lastT = now
        local jump
        if d.last and dt > 0 then
            local delta = pos - d.last
            d.hs = Vector3.new(delta.X, 0, delta.Z).Magnitude / dt
            d.vs = delta.Y / dt
            jump = delta.Magnitude
        end
        d.last = pos
        local seated = hum.SeatPart ~= nil
        local ground = workspace:Raycast(pos, Vector3.new(0, -14, 0), filter.ray)
        if ground or seated then d.airT = 0 elseif dt > 0 then d.airT = d.airT + dt end
        d.seated = seated
        return jump, dt
    end

    -- ---------------------------------------------------------
    --  aprendido: cargar / guardar
    -- ---------------------------------------------------------
    local function countLearned()
        local items, anims = 0, 0
        for _, t in pairs(learned.items) do
            items = items + 1
            for _ in pairs(t) do anims = anims + 1 end
        end
        return items, anims
    end

    local function saveLearned(silent)
        if typeof(writefile) ~= "function" then
            if not silent then say("Monitor", "Tu ejecutor no tiene writefile: no se puede guardar") end
            return false
        end
        if typeof(isfolder) == "function" and typeof(makefolder) == "function" and not isfolder(FOLDER) then
            pcall(makefolder, FOLDER)
        end
        local ok, encoded = pcall(function() return HttpService:JSONEncode(learned) end)
        if not ok then return false end
        local okW = pcall(writefile, FILE, encoded)
        if okW and not silent then
            local i, a = countLearned()
            say("Monitor", "Guardado: " .. i .. " items, " .. a .. " animaciones")
        end
        return okW
    end

    local function loadLearned()
        if typeof(isfile) ~= "function" or typeof(readfile) ~= "function" or not isfile(FILE) then return end
        local ok, decoded = pcall(function() return HttpService:JSONDecode(readfile(FILE)) end)
        if ok and typeof(decoded) == "table" and typeof(decoded.items) == "table" then learned = decoded end
    end
    loadLearned()

    local function learnEntry(tool, id)
        local it = learned.items[tool]
        if not it then it = {} learned.items[tool] = it end
        local e = it[id]
        if not e then e = { hs = 0, air = 0, n = 0 } it[id] = e end
        return e
    end

    -- ---------------------------------------------------------
    --  animaciones de OTROS jugadores
    -- ---------------------------------------------------------
    local function onAnimStart(p, d, track)
        if d.seen[track] then return end
        d.seen[track] = true
        if not isAction(track) then return end
        local id = animId(track)
        if not id then return end
        local now = os.clock()
        d.anims[#d.anims + 1] = { t = now, id = id }
        d.attacks = d.attacks + 1
        do
            local un = toolName(p.Character)
            d.uses[un] = (d.uses[un] or 0) + 1
        end
        while d.anims[1] and now - d.anims[1].t > 3 do table.remove(d.anims, 1) end
        recentCasts[p] = now

        -- ritmo contra lo aprendido para este item
        local tool = toolName(p.Character)
        local e = learned.items[tool] and learned.items[tool][id]
        local key = tool .. "|" .. id
        local last = d.lastStart[key]
        d.lastStart[key] = now
        if e and e.gap and (e.n or 0) >= 3 and last then
            local g = now - last
            if g >= 0.05 and g < e.gap * cfg.paceFactor then
                d.pace[#d.pace + 1] = now
                d.paceInfo = tool .. " " .. shortId(id)
            end
        end
    end

    local function hookAnimator(p, d, hum)
        local animator = hum:FindFirstChildOfClass("Animator")
        if animator and d.animator ~= animator then
            if d.animConn then d.animConn:Disconnect() end
            d.animator = animator
            d.animConn = animator.AnimationPlayed:Connect(function(track) onAnimStart(p, d, track) end)
        end
        return animator
    end

    -- lo que permite lo aprendido segun las animaciones que uso hace poco
    local function allowance(p, d, now)
        local tool = toolName(p.Character)
        local items = learned.items[tool]
        if not items then return 0, 0 end
        local ah, aa = 0, 0
        for _, a in ipairs(d.anims) do
            if now - a.t <= 1.5 then
                local e = items[a.id]
                if e then
                    ah = math.max(ah, e.hs or 0)
                    aa = math.max(aa, e.air or 0)
                end
            end
        end
        return ah, aa
    end

    -- ---------------------------------------------------------
    --  etiqueta sobre la cabeza
    -- ---------------------------------------------------------
    local function setTag(p, d, text)
