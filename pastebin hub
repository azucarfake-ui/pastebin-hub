    -- ---------------------------------------------------------
    --  revision de UN jugador
    -- ---------------------------------------------------------
    local function check(p, d, now, filter)
        local char = p.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not (hrp and hum and hum.Health > 0) then
            d.last, d.char, d.airT, d.status, d.hs, d.vs, d.rate = nil, nil, 0, "-", 0, 0, 0
            table.clear(d.score); table.clear(d.flash); table.clear(d.anims); table.clear(d.pace)
            setTag(p, d, nil)
            return
        end

        -- personaje nuevo (reaparecio): empezar de cero y dar 3 s de margen
        if d.char ~= char then
            d.char, d.last, d.airT, d.grace = char, nil, 0, now + 3
            d.peakHs, d.peakVs, d.peakRate, d.peakSpin, d.peakFx = 0, 0, 0, 0, 0
            d.look, d.held = nil, nil
            table.clear(d.swaps); table.clear(d.fx)
            table.clear(d.score); table.clear(d.flash); table.clear(d.anims); table.clear(d.pace)
        end

        local animator = hookAnimator(p, d, hum)
        if animator then
            for _, tr in ipairs(animator:GetPlayingAnimationTracks()) do onAnimStart(p, d, tr) end
        end

        local tn, tc = heldTool(char)
        if tn then
            local group = d.tools[tc]
            if not group then group = {} d.tools[tc] = group end
            group[tn] = true
        end

        local prev = d.last
        local jump, dt = measure(d, hrp, hum, now, filter)
        local grace = d.grace or 0

        if now > grace then
            -- teletransporte
            if jump and jump > cfg.tpDist then
                raise(p, d, "Teleport?", string.format("(%.0f studs en %.1fs) desde %s", jump, dt, fmtPos(prev)))
                d.airT = 0
                return
            end

            if not d.seated then
                d.peakHs = math.max(d.peakHs, d.hs)
                d.peakVs = math.max(d.peakVs, math.abs(d.vs))
            end

            -- lo que permite lo aprendido (dashes, vuelos legitimos de una habilidad)
            local ah, aa = allowance(p, d, now)

            if bump(d, "Flying?", d.airT > cfg.flyTime and d.vs > -10 and d.airT > aa * 1.15) then
                raise(p, d, "Flying?", string.format("(%.1fs en el aire, vel %.0f)", d.airT, d.hs))
            end
            if bump(d, "Speed?", not d.seated and d.hs > cfg.maxSpeed and d.hs > ah * 1.15) then
                raise(p, d, "Speed?", string.format("(%.0f studs/s, WalkSpeed %.0f)", d.hs, hum.WalkSpeed))
            end

            -- atravesar paredes: el centro del personaje esta dentro de una pieza solida
            if cfg.noclip and not d.seated then
                local inside = false
                local ok, parts = pcall(workspace.GetPartBoundsInRadius, workspace, hrp.Position, 0.7, filter.ov)
                if ok then
                    for _, part in ipairs(parts) do
                        if part.CanCollide then inside = true break end
                    end
                end
                if bump(d, "Noclip?", inside) then raise(p, d, "Noclip?", "(dentro de una pieza solida)") end
            end

            -- cambios de item muy seguidos (los fast attack suelen alternar herramientas)
            if tn ~= d.held then
                if d.held ~= nil then d.swaps[#d.swaps + 1] = now end
                d.held = tn
            end
            while d.swaps[1] and now - d.swaps[1] > 2 do table.remove(d.swaps, 1) end
            d.swapN = #d.swaps
            if bump(d, "SwapSpam?", cfg.swapOn and d.swapN >= cfg.swapRate) then
                raise(p, d, "SwapSpam?", string.format("(%d cambios de item en 2s)", d.swapN))
            end

            -- giros: cambio de direccion por segundo
            local lv = hrp.CFrame.LookVector
            if d.look and dt > 0 then
                local flat, prevFlat = Vector3.new(lv.X, 0, lv.Z), Vector3.new(d.look.X, 0, d.look.Z)
                if flat.Magnitude > 0.01 and prevFlat.Magnitude > 0.01 then
                    local dot = math.clamp(flat.Unit:Dot(prevFlat.Unit), -1, 1)
                    d.spin = math.deg(math.acos(dot)) / dt
                    d.peakSpin = math.max(d.peakSpin, d.spin)
                end
            end
            d.look = lv
            if bump(d, "Spin?", not d.seated and d.spin > cfg.spinSpeed) then
                raise(p, d, "Spin?", string.format("(%.0f grados/s)", d.spin))
            end

            -- WalkSpeed y salto fuera de lo normal
            local okS, ws = pcall(function() return hum.WalkSpeed end)
            local okJ, jp = pcall(function() return hum.UseJumpPower and hum.JumpPower or hum.JumpHeight * 7 end)
            if okS then d.peakWalk = math.max(d.peakWalk, ws) end
            if bump(d, "Stats?", (okS and ws > cfg.maxWalk) or (okJ and jp > cfg.maxJump)) then
                raise(p, d, "Stats?", string.format("(WalkSpeed %.0f, salto %.0f)", okS and ws or 0, okJ and jp or 0))
            end

            -- efectos por segundo (solo si el modulo esta encendido)
            if cfg.effects then
                local n = 0
                for i = #d.fx, 1, -1 do
                    if now - d.fx[i] <= 1 then n = n + 1 else table.remove(d.fx, i) end
                end
                d.fxRate = n
                d.peakFx = math.max(d.peakFx, n)
                if bump(d, "EffectSpam?", n > cfg.effectRate) then
                    raise(p, d, "EffectSpam?", string.format("(%d efectos/s cerca de %s)", n, fmtPos(d.lastFx)))
                end
            end

            -- ritmo de animaciones de accion
            local cnt, perId, maxRep = 0, {}, 0
            for _, a in ipairs(d.anims) do
                if now - a.t <= 1 then
                    cnt = cnt + 1
                    perId[a.id] = (perId[a.id] or 0) + 1
                    if perId[a.id] > maxRep then maxRep = perId[a.id] end
                end
            end
            d.rate = cnt
            if cnt > d.peakRate then d.peakRate, d.peakTool = cnt, (heldTool(char)) or "-" end
            if bump(d, "FastAttack?", cnt > cfg.animRate or maxRep > cfg.animRepeat) then
                raise(p, d, "FastAttack?", string.format("(%d ataques/s, misma x%d)", cnt, maxRep))
            end

            -- ritmo contra lo aprendido por item
            while d.pace[1] and now - d.pace[1] > 2 do table.remove(d.pace, 1) end
            if #d.pace >= 3 then
                raise(p, d, "FastItem?", "(" .. tostring(d.paceInfo) .. " mas rapido de lo aprendido)")
                table.clear(d.pace)
            end
        end

        local names = {}
        for _, k in ipairs(KINDS) do
            if (d.flash[k] or 0) > now then names[#names + 1] = k end
        end
        d.status = #names > 0 and table.concat(names, " ") or "OK"
        setTag(p, d, #names > 0 and table.concat(names, " ") or nil)
    end

    -- ---------------------------------------------------------
    --  MODO APRENDER (tus propias acciones)
    -- ---------------------------------------------------------
    local function onSelfAnim(track)
        if selfD.seen[track] then return end
        selfD.seen[track] = true
        if not cfg.learn or not isAction(track) then return end
        local id = animId(track)
        if not id then return end
        local tool = toolName(lp.Character)
        local key = tool .. "|" .. id
        local now = os.clock()
        local last = selfD.lastStart[key]
        selfD.lastStart[key] = now
        local e = learnEntry(tool, id)
        e.n = e.n + 1
        if last then
            local g = now - last
            if g >= 0.15 then e.gap = e.gap and math.min(e.gap, g) or g end
        end
    end

    local function learnTick(now, filter)
        local char = lp.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not (hrp and hum and hum.Health > 0) then selfD.last = nil return end
        if selfD.char ~= char then selfD.char, selfD.last, selfD.airT = char, nil, 0 end
        local animator = hum:FindFirstChildOfClass("Animator")
        if animator and selfD.animator ~= animator then
            if selfConn then selfConn:Disconnect() end
            selfD.animator = animator
            selfConn = animator.AnimationPlayed:Connect(onSelfAnim)
        end
        measure(selfD, hrp, hum, now, filter)
        if not animator then return end
        local tool = toolName(char)
        for _, tr in ipairs(animator:GetPlayingAnimationTracks()) do
            onSelfAnim(tr)
            if isAction(tr) then
                local id = animId(tr)
                if id then
                    local e = learnEntry(tool, id)
                    e.hs = math.max(e.hs or 0, selfD.hs)
                    e.air = math.max(e.air or 0, selfD.airT)
                end
            end
        end
    end

    -- ---------------------------------------------------------
    --  bucle unico
    -- ---------------------------------------------------------
    local function loop(myGen)
        while (cfg.on or cfg.learn) and gen == myGen and alive do
            local now = os.clock()
            local filter = buildFilter()
            if cfg.learn then pcall(learnTick, now, filter) end
            if cfg.on then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= lp and not cfg.ignore[p.Name] then pcall(check, p, getData(p), now, filter) end
                end
            end
            task.wait(cfg.step)
        end
        if gen == myGen then running = false end
    end

    local function ensureLoop()
        if running then return end
        running = true
        gen = gen + 1
        task.spawn(loop, gen)
    end

    local function clearTags()
        for p, d in pairs(data) do setTag(p, d, nil) end
    end

    table.insert(conns, Players.PlayerRemoving:Connect(function(p)
        local d = data[p]
        if d then
            if d.animConn then d.animConn:Disconnect() end
            if d.tag then d.tag:Destroy() end
        end
        data[p], recentCasts[p] = nil, nil
    end))

    -- ---------------------------------------------------------
    --  efectos lejanos (experimental)
    --  Tras lanzar una accion, cuenta piezas nuevas que aparecen muy lejos del que la lanzo.
    -- ---------------------------------------------------------
    local function setFar(on)
        if farConn then farConn:Disconnect() farConn = nil end
        if not on then return end
        farConn = workspace.DescendantAdded:Connect(function(o)
            if not (cfg.on and cfg.far) or next(recentCasts) == nil then return end
            if not o:IsA("BasePart") then return end
            local now = os.clock()
            for p, t in pairs(recentCasts) do
                if now - t > 1.2 then
                    recentCasts[p] = nil
                else
                    local d = data[p]
                    local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
                    if d and hrp and not o:IsDescendantOf(p.Character)
                        and (o.Position - hrp.Position).Magnitude > cfg.farDist then
                        d.far = (d.far or 0) + 1
                        if d.far >= 3 then
                            d.far = 0
                            raise(p, d, "FarEffect?", string.format("(piezas a mas de %d studs)", cfg.farDist))
                        end
                    end
                end
            end
        end)
    end

    -- efectos: cuenta piezas y particulas nuevas y las asigna al jugador que lanzo algo hace poco y esta mas cerca
    local fxConn
    local function setEffects(on)
        if fxConn then fxConn:Disconnect() fxConn = nil end
        if not on then return end
        fxConn = workspace.DescendantAdded:Connect(function(o)
            if not (cfg.on and cfg.effects) or next(recentCasts) == nil then return end
            if not (o:IsA("BasePart") or o:IsA("ParticleEmitter")) then return end
            local now = os.clock()
            local pos = o:IsA("BasePart") and o.Position or (o.Parent and o.Parent:IsA("BasePart") and o.Parent.Position)
            if not pos then return end
            local best, bestD
            for p, t in pairs(recentCasts) do
                if now - t > 1.2 then
                    recentCasts[p] = nil
                else
                    local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
                    if hrp and not o:IsDescendantOf(p.Character) then
                        local dist = (pos - hrp.Position).Magnitude
                        if not bestD or dist < bestD then best, bestD = p, dist end
                    end
                end
            end
            local d = best and data[best]
            if d then
                d.fx[#d.fx + 1] = now
                d.lastFx = pos
            end
        end)
    end
    table.insert(conns, { Disconnect = function() if fxConn then fxConn:Disconnect() fxConn = nil end end })

    -- nota de sospecha 0-100 segun cuantos avisos acumulo y de que tipo
    local function suspicion(d)
        local total = 0
        for kind, n in pairs(d.counts) do total = total + (WEIGHT[kind] or 8) * math.min(n, 5) end
        return math.min(100, total)
    end

    local function topUses(d)
        local arr = {}
        for n, c in pairs(d.uses) do arr[#arr + 1] = { n, c } end
        table.sort(arr, function(a, b) return a[2] > b[2] end)
        local out = {}
        for i = 1, math.min(4, #arr) do out[i] = arr[i][1] .. " x" .. arr[i][2] end
        return #out > 0 and table.concat(out, ", ") or "sin usos"
    end

    local function countsLine(d)
        local out = {}
        for _, k in ipairs(KINDS) do
            if d.counts[k] then out[#out + 1] = k .. " x" .. d.counts[k] end
        end
        return #out > 0 and table.concat(out, ", ") or "ninguno"
    end

    -- ---------------------------------------------------------
    --  reportes
    -- ---------------------------------------------------------
    local ORDER = { "Fruit", "Sword", "Melee", "Gun" }

    local function toolsLine(d)
        local out = {}
        for _, k in ipairs(ORDER) do
            local names = {}
            for n in pairs(d.tools[k] or {}) do names[#names + 1] = n end
            table.sort(names)
            if #names > 0 then out[#out + 1] = k .. ": " .. table.concat(names, ", ") end
        end
        for k, set in pairs(d.tools) do
            if not table.find(ORDER, k) then
                local names = {}
                for n in pairs(set) do names[#names + 1] = n end
                table.sort(names)
                out[#out + 1] = k .. ": " .. table.concat(names, ", ")
            end
        end
        return #out > 0 and table.concat(out, " | ") or "nada visto aun"
    end

    -- ficha completa de un jugador
    local function dossier(p, d)
        local char = p.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local lvl, race, fruit, bounty = playerInfo(p)
        local tn, tc = heldTool(char)
        local lines = {
            string.format("%s (@%s)  estado: %s", p.DisplayName, p.Name, d.status or "-"),
            string.format("Nivel %s | Raza %s%s | Bounty %s", tostring(lvl or "?"), tostring(race or "?"), isV4(char) and " V4" or "", compact(bounty)),
            "Fruta: " .. ((fruit and fruit ~= "") and tostring(fruit) or "ninguna / oculta"),
            "En la mano: " .. (tn and (tc .. " - " .. tn) or "nada"),
            "Visto: " .. toolsLine(d),
            "Pos: " .. fmtPos(hrp and hrp.Position),
            string.format("Vel: %.0f (pico %.0f) | vertical %.0f (pico %.0f) | WalkSpeed %s | Salto %s",
                d.hs, d.peakHs, d.vs, d.peakVs, hum and string.format("%.0f", hum.WalkSpeed) or "?", hum and string.format("%.0f", hum.JumpPower) or "?"),
            string.format("Aire: %.1fs | Vida: %s", d.airT, hum and string.format("%.0f/%.0f", hum.Health, hum.MaxHealth) or "?"),
            string.format("Ataques: %d total | %d/s ahora | pico %d/s (%s) | alertas de fast attack: %d",
                d.attacks, d.rate or 0, d.peakRate, d.peakTool, d.fastFlags),
            "Mas usados: " .. topUses(d),
            string.format("Giro: %.0f grados/s (pico %.0f) | cambios de item 2s: %d | WalkSpeed pico %.0f",
                d.spin, d.peakSpin, d.swapN, d.peakWalk),
            cfg.effects and string.format("Efectos: %d/s (pico %d) | ultimo en %s", d.fxRate, d.peakFx, fmtPos(d.lastFx)) or "Efectos: modulo apagado",
            string.format("Sospecha %d/100 | avisos: %s | observado %.0f s", suspicion(d), countsLine(d), os.clock() - d.since),
        }
        if #d.events > 0 then
            lines[#lines + 1] = "Ultimos avisos:"
            for i = #d.events, math.max(1, #d.events - 3), -1 do
                local e = d.events[i]
                lines[#lines + 1] = "  [" .. e.t .. "] " .. e.kind .. " " .. e.detail
            end
        end
        return table.concat(lines, "\n")
    end

    local function reportText()
        local parts = {}
        for p, d in pairs(data) do parts[#parts + 1] = { suspicion(d), dossier(p, d) } end
        table.sort(parts, function(a, b) return a[1] > b[1] end)
        local out = {}
        for i, e in ipairs(parts) do out[i] = e[2] end
        if #out == 0 then return "Sin datos todavia: enciende el Monitor y espera unos segundos." end
        return table.concat(out, "\n\n")
    end

    local function report()
        print("---- Player Monitor ----")
        print(reportText())
    end

    local function fullText()
        local lines = { reportText(), "", "---- Registro de avisos ----" }
        for _, e in ipairs(log) do lines[#lines + 1] = string.format("[%s] %s %s %s", e.t, e.name, e.kind, e.detail) end
        return table.concat(lines, "\n")
    end

    local function saveReport()
        if typeof(writefile) ~= "function" then say("Monitor", "Tu ejecutor no tiene writefile") return end
        if typeof(isfolder) == "function" and typeof(makefolder) == "function" and not isfolder(FOLDER) then pcall(makefolder, FOLDER) end
        local path = FOLDER .. "/reporte_" .. os.date("%Y%m%d_%H%M%S") .. ".txt"
        if pcall(writefile, path, fullText()) then say("Monitor", "Guardado en " .. path) else say("Monitor", "No se pudo guardar") end
    end

    local function copyReport()
        if typeof(setclipboard) ~= "function" then say("Monitor", "Tu ejecutor no tiene setclipboard") return end
        pcall(setclipboard, fullText())
        say("Monitor", "Reporte copiado")
    end

    local function printLog()
        print("---- Registro de avisos ----")
        if #log == 0 then print("(vacio)") return end
        for _, e in ipairs(log) do print(string.format("[%s] %-16s %-11s %s", e.t, e.name, e.kind, e.detail)) end
    end

    local function flaggedText()
        local out = {}
        for p, d in pairs(data) do
            if d.status ~= "-" and d.status ~= "OK" and not cfg.ignore[p.Name] then
                out[#out + 1] = { suspicion(d), p.Name .. " [" .. suspicion(d) .. "]: " .. d.status }
            end
        end
        table.sort(out, function(a, b) return a[1] > b[1] end)
        for i, e in ipairs(out) do out[i] = e[2] end
        if #out == 0 then return "Nadie marcado" end
        if #out > 6 then out = { table.unpack(out, 1, 6) } end
        return table.concat(out, "\n")
    end

    local function learnedText()
        local i, a = countLearned()
        return "Aprendido: " .. i .. " items, " .. a .. " animaciones"
    end

    _G.PlayerMonitor = { Data = data, Learned = learned, Config = cfg, Log = log, Report = report }
    _G.__PlayerMonitorStop = function()
        alive = false
        cfg.on, cfg.learn, cfg.far, cfg.effects = false, false, false, false
        gen = gen + 1
        if farConn then farConn:Disconnect() farConn = nil end
        if selfConn then selfConn:Disconnect() selfConn = nil end
        for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
        for p, d in pairs(data) do
            if d.animConn then d.animConn:Disconnect() end
            setTag(p, d, nil)
        end
    end

    -- ---------------------------------------------------------
    --  interfaz (solo si hay ventana)
    -- ---------------------------------------------------------
    do
        local Tab = window:CreateTab({ Name = options.TabName or "Monitor" })
        local function section(text)
            pcall(function()
                if Tab.CreateSection then Tab:CreateSection(text) else Tab:CreateSectionLabel(text) end
            end)
        end
        local FlagLabel, LearnLabel
        pcall(function() FlagLabel = Tab:CreateLabel("Nadie marcado") end)

        section("Jugador")
        local PlayerDD, DossierLabel
        local function names()
            local out = {}
            for p in pairs(data) do if p.Parent then out[#out + 1] = p.Name end end
            table.sort(out)
            if #out == 0 then out[1] = "(nadie)" end
            return out
        end
        pcall(function() PlayerDD = Tab:CreateDropdown({ Text = "Ver jugador", Options = names(), Callback = function() end }) end)
        pcall(function() DossierLabel = Tab:CreateLabel("Enciende el Monitor y elige un jugador") end)
        local lastNames = ""

        section("Monitor")
        Tab:CreateToggle({
            Text = "Monitor", Default = false, Flag = "MonitorOn",
            Callback = function(v)
                cfg.on = v
                if v then ensureLoop() else clearTags() end
            end,
        })
        Tab:CreateToggle({ Text = "Avisos en pantalla", Default = true, Flag = "MonitorNotify", Callback = function(v) cfg.notify = v end })
        Tab:CreateToggle({
            Text = "Etiquetas sobre la cabeza", Default = false, Flag = "MonitorTags",
            Callback = function(v) cfg.tags = v if not v then clearTags() end end,
        })
        Tab:CreateToggle({ Text = "Detectar atravesar paredes", Default = true, Flag = "MonitorNoclip", Callback = function(v) cfg.noclip = v end })
        Tab:CreateToggle({
            Text = "Efectos lejanos (experimental)", Default = false, Flag = "MonitorFar",
            Callback = function(v) cfg.far = v setFar(v) end,
        })

        Tab:CreateToggle({ Text = "Detectar cambios de item", Default = true, Flag = "MonitorSwap", Callback = function(v) cfg.swapOn = v end })
        Tab:CreateToggle({
            Text = "Contar efectos (experimental)", Default = false, Flag = "MonitorEffects",
            Callback = function(v) cfg.effects = v setEffects(v) end,
        })

        section("Limites")
        Tab:CreateSlider({ Text = "Cambios de item en 2s", Range = { 2, 12 }, Default = 5, Flag = "MonitorSwapRate", Callback = function(v) cfg.swapRate = v end })
        Tab:CreateSlider({ Text = "Giro maximo (grados/s)", Range = { 300, 2000 }, Increment = 50, Default = 700, Flag = "MonitorSpin", Callback = function(v) cfg.spinSpeed = v end })
        Tab:CreateSlider({ Text = "WalkSpeed maximo", Range = { 20, 200 }, Default = 70, Flag = "MonitorWalk", Callback = function(v) cfg.maxWalk = v end })
        Tab:CreateSlider({ Text = "Efectos por segundo", Range = { 20, 500 }, Increment = 10, Default = 120, Flag = "MonitorFxRate", Callback = function(v) cfg.effectRate = v end })
        Tab:CreateSlider({ Text = "Velocidad maxima", Range = { 30, 300 }, Default = 90, Flag = "MonitorSpeed", Callback = function(v) cfg.maxSpeed = v end })
        Tab:CreateSlider({ Text = "Tiempo en el aire (s)", Range = { 1, 8 }, Increment = 0.5, Default = 2.5, Flag = "MonitorFly", Callback = function(v) cfg.flyTime = v end })
        Tab:CreateSlider({ Text = "Distancia de teletransporte", Range = { 50, 1000 }, Increment = 10, Default = 200, Flag = "MonitorTp", Callback = function(v) cfg.tpDist = v end })
        Tab:CreateSlider({ Text = "Animaciones por segundo", Range = { 3, 20 }, Default = 7, Flag = "MonitorAnimRate", Callback = function(v) cfg.animRate = v end })
        Tab:CreateSlider({ Text = "Misma animacion repetida", Range = { 2, 12 }, Default = 5, Flag = "MonitorAnimRepeat", Callback = function(v) cfg.animRepeat = v end })
        Tab:CreateSlider({ Text = "Efectos lejanos (studs)", Range = { 200, 2000 }, Increment = 50, Default = 600, Flag = "MonitorFarDist", Callback = function(v) cfg.farDist = v end })

        section("Aprender")
        pcall(function() LearnLabel = Tab:CreateLabel(learnedText()) end)
        Tab:CreateToggle({
            Text = "Modo aprender (mis acciones)", Default = false, Flag = "MonitorLearn",
            Callback = function(v)
                cfg.learn = v
                if v then ensureLoop() else saveLearned(true) end
            end,
        })
        Tab:CreateButton({ Text = "Guardar lo aprendido", Callback = function() saveLearned(false) end })
        Tab:CreateButton({
            Text = "Borrar lo aprendido",
            Callback = function()
                learned.items = {}
                saveLearned(true)
                say("Monitor", "Se borro lo aprendido")
            end,
        })

        section("Registro")
        Tab:CreateButton({ Text = "Imprimir reporte (F9)", Callback = report })
        Tab:CreateButton({ Text = "Imprimir registro (F9)", Callback = printLog })
        Tab:CreateButton({ Text = "Guardar reporte (archivo)", Callback = saveReport })
        Tab:CreateButton({ Text = "Copiar reporte", Callback = copyReport })
        Tab:CreateButton({
            Text = "Ignorar / vigilar jugador elegido",
            Callback = function()
                local name = PlayerDD and PlayerDD.Value
                if not name or name == "(nadie)" then return end
                cfg.ignore[name] = not cfg.ignore[name] or nil
                say("Monitor", name .. (cfg.ignore[name] and " ignorado" or " vigilado otra vez"))
            end,
        })
        Tab:CreateButton({
            Text = "Borrar historial de todos",
            Callback = function()
                for p, d in pairs(data) do
                    d.counts, d.events, d.tools, d.uses = {}, {}, {}, {}
                    d.attacks, d.fastFlags, d.peakHs, d.peakVs, d.peakRate, d.peakSpin, d.peakFx = 0, 0, 0, 0, 0, 0, 0
                end
                table.clear(log)
                say("Monitor", "Historial borrado")
            end,
        })

        -- refresca los textos una vez por segundo
        task.spawn(function()
            while alive do
                task.wait(1)
                if FlagLabel and FlagLabel.Set and cfg.on then pcall(function() FlagLabel:Set(flaggedText()) end) end
                if LearnLabel and LearnLabel.Set then pcall(function() LearnLabel:Set(learnedText()) end) end
                if PlayerDD and cfg.on then
                    pcall(function()
                        local list = names()
                        local key = table.concat(list, ",")
                        if key ~= lastNames then
                            lastNames = key
                            PlayerDD:Refresh(list, true)
                        end
                        local sel
                        for p, d in pairs(data) do if p.Name == PlayerDD.Value then sel = { p, d } end end
                        if not sel then
                            for p, d in pairs(data) do if d.status ~= "-" and d.status ~= "OK" then sel = { p, d } break end end
                        end
                        if DossierLabel and DossierLabel.Set then
                            DossierLabel:Set(sel and dossier(sel[1], sel[2]) or "Elige un jugador")
                        end
                    end)
                end
            end
        end)
    end

    -- al destruir la ventana, tambien se detiene el monitor
    window._monitorStop = _G.__PlayerMonitorStop
    if options.AutoStart then
        cfg.on = true
        ensureLoop()
    end
    return window
end

return UI
